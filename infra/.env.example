# Pinned image digests (resolve with: docker buildx imagetools inspect <image>:<tag>)
POSTGRES_IMAGE=postgres:<tag>@sha256:<digest>
NODE_IMAGE=node:<tag>@sha256:<digest>
REDIS_IMAGE=redis:<tag>@sha256:<digest>
# Use a python-bearing uv tag (e.g. uv:<ver>-python3.13-alpine); bare uv:latest
# and other distroless tags ship only the uv binary — no python for the healthcheck.
UV_IMAGE=ghcr.io/astral-sh/uv:<ver>-python3.13-alpine@sha256:<digest>
# Disposable password for the isolated jejakpeluang_e2e database only
TEST_DB_PASSWORD=<url-safe-random>
# Optional host port overrides (defaults: API_PORT=8000, WEB_PORT=3000)
# API_PORT=8000
# WEB_PORT=3000
# Intake/moderation: dev defaults are baked into compose.dev.yml, so these
# are only needed to override them. Never reuse these defaults outside dev.
# AUTH_SECRET=<url-safe-random>
# RATE_LIMIT_SALT=<url-safe-random>
# COOKIE_SECURE=false
# APP_ENV=production fails startup unless the above secrets are non-default
# and COOKIE_SECURE=true.
# APP_ENV=development
# ACCESS_TOKEN_TTL_SECONDS=28800
# RATE_LIMITER=redis   (shared limiter; default 'memory' is per-process)
# TRUSTED_PROXY_CIDRS — comma-separated CIDRs of reverse proxies allowed to
# supply X-Forwarded-For client identity for rate limiting (e.g. the Traefik
# network). Empty = only the socket peer is trusted.
# TRUSTED_PROXY_CIDRS=
# SWEEP_INTERVAL_SECONDS=3600
# Screening providers — required for the worker to screen; empty keys degrade
# runs to manual_review/provider_unavailable outcomes instead of failing intake.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-6-luna
# TYPESAFE_API_KEY=
# TAVILY_API_KEY=
# Optional: override the pinned headless-browser base image for the renderer service
# RENDERER_IMAGE=mcr.microsoft.com/playwright/python:v1.62.0-noble@sha256:<digest>
