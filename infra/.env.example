# Pinned image digests (resolve with: docker buildx imagetools inspect <image>:<tag>)
POSTGRES_IMAGE=postgres:<tag>@sha256:<digest>
NODE_IMAGE=node:<tag>@sha256:<digest>
# Use a python-bearing uv tag (e.g. uv:<ver>-python3.13-alpine); bare uv:latest
# and other distroless tags ship only the uv binary — no python for the healthcheck.
UV_IMAGE=ghcr.io/astral-sh/uv:<ver>-python3.13-alpine@sha256:<digest>
# Disposable password for the isolated jejakpeluang_e2e database only
TEST_DB_PASSWORD=<url-safe-random>
# Optional host port overrides (defaults: API_PORT=8000, WEB_PORT=3000)
# API_PORT=8000
# WEB_PORT=3000
# Intake/moderation: dev defaults are baked into compose.dev.yml, so these
# are only needed to override them. Never reuse these defaults outside dev.
# AUTH_SECRET=<url-safe-random>
# RATE_LIMIT_SALT=<url-safe-random>
# COOKIE_SECURE=false
